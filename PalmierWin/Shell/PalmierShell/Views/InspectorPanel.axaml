<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PalmierShell.ViewModels"
             xmlns:core="clr-namespace:PalmierShell.Core"
             xmlns:views="clr-namespace:PalmierShell.Views"
             x:Class="PalmierShell.Views.InspectorPanel"
             x:DataType="vm:InspectorViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.field">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource ThemeTextTertiaryBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.value">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinWidth" Value="64"/>
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <!-- Per-property keyframe diamond: dim until the row is hovered. -->
    <Style Selector="Button.key">
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="4,2,0,2"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Opacity" Value="0.45"/>
      <Setter Property="Transitions">
        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.12"/></Transitions>
      </Setter>
      <Setter Property="Content">
        <Template>
          <Path Data="M 5,0 L 10,5 L 5,10 L 0,5 Z" Stroke="{StaticResource ThemeTimecodeBrush}"
                StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Template>
      </Setter>
    </Style>
    <Style Selector="Button.key:pointerover">
      <Setter Property="Opacity" Value="1"/>
    </Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="12,8">
      <TextBlock Text="Inspector" FontSize="12"
                 Foreground="{StaticResource ThemeTextSecondaryBrush}"/>
      <!-- Nothing selected: fall back to the project/sequence summary. -->
      <StackPanel IsVisible="{Binding NothingSelected}">
        <Expander Classes="section" Header="PROJECT" IsExpanded="True">
          <Grid ColumnDefinitions="82,*" RowDefinitions="Auto,Auto">
            <Grid.Styles>
              <Style Selector="TextBlock"><Setter Property="Margin" Value="0,2"/></Style>
            </Grid.Styles>
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Name"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Classes="field" Text="Untitled Project"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Duration"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="field" Text="{Binding ProjectDuration}"
                       FontFamily="Consolas"/>
          </Grid>
        </Expander>
        <Expander Classes="section" Header="SETTINGS">
          <Grid ColumnDefinitions="82,*" RowDefinitions="Auto,Auto,Auto">
            <Grid.Styles>
              <Style Selector="TextBlock"><Setter Property="Margin" Value="0,2"/></Style>
            </Grid.Styles>
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Resolution"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Classes="field" Text="{Binding ProjectResolution}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Frame Rate"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="field" Text="{Binding ProjectFrameRate}"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="Aspect Ratio"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Classes="field" Text="{Binding ProjectAspect}"/>
          </Grid>
        </Expander>
      </StackPanel>
      <StackPanel IsVisible="{Binding HasMediaSelection}">
        <TextBlock Text="{Binding MediaName}" FontSize="13" Margin="0,8,0,0"/>
        <Expander Classes="section" Header="DETAILS" IsExpanded="True">
          <Grid ColumnDefinitions="82,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
            <Grid.Styles>
              <Style Selector="TextBlock"><Setter Property="Margin" Value="0,2"/></Style>
            </Grid.Styles>
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Type"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Classes="field" Text="Video"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Resolution"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="field" Text="{Binding MediaResolution}"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="FPS"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Classes="field" Text="{Binding MediaFps}"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Classes="field" Text="Duration"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Classes="field" Text="{Binding MediaDuration}"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Classes="field" Text="Path"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Classes="field" Text="{Binding MediaPath}"
                       TextWrapping="Wrap" FontSize="10"/>
          </Grid>
        </Expander>
      </StackPanel>
      <!-- Provenance: what generated this clip, and the stills it came from. -->
      <StackPanel IsVisible="{Binding IsGenerated}">
        <Expander Classes="section" Header="GENERATED">
          <Grid ColumnDefinitions="82,*" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Provider"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Classes="field" Text="{Binding GenerationProvider}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Model"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="field" Text="{Binding GenerationModel}"
                       TextWrapping="Wrap"/>
          </Grid>
        </Expander>
        <Expander Classes="section" Header="PROMPT">
          <StackPanel>
            <SelectableTextBlock Text="{Binding GenerationPrompt}" FontSize="11" TextWrapping="Wrap"
                                 Foreground="{StaticResource ThemeTextTertiaryBrush}"/>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="6" Margin="0,8,0,0">
              <Image Grid.Column="0" Source="{Binding GenerationFirstFrame}" Height="54"
                     Stretch="UniformToFill"/>
              <Image Grid.Column="1" Source="{Binding GenerationLastFrame}" Height="54"
                     Stretch="UniformToFill"/>
            </Grid>
          </StackPanel>
        </Expander>
      </StackPanel>
      <StackPanel IsVisible="{Binding HasSelection}">
        <TextBlock Text="{Binding ClipName}" FontSize="13" Margin="0,8,0,0"/>

        <StackPanel IsVisible="{Binding IsTextClip}">
          <Expander Classes="section" Header="TEXT" IsExpanded="True">
            <StackPanel>
              <TextBox Classes="value" Text="{Binding TextContent}" AcceptsReturn="False"/>
              <Grid ColumnDefinitions="82,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="2" Margin="0,4,0,0">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Size"/>
                <TextBox Grid.Row="0" Grid.Column="1" Classes="value" Text="{Binding TextFontSize, Converter={x:Static core:DoubleTextConverter.Instance}}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Color"/>
                <TextBox Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding TextColorHex}"
                         Watermark="#RRGGBB"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="Align"/>
                <TextBox Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding TextAlignment}"
                         Watermark="left / center / right"/>
              </Grid>
            </StackPanel>
          </Expander>
        </StackPanel>

        <Expander Classes="section" Header="TRANSFORM" IsExpanded="True">
          <!-- Each animatable row carries its own keyframe diamond, so it is
               always clear which property gets a key. -->
          <Grid ColumnDefinitions="82,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Center X"/>
            <TextBox Grid.Row="0" Grid.Column="1" Classes="value" Text="{Binding CenterX, Converter={x:Static core:DoubleTextConverter.Instance}}"/>
            <Button Grid.Row="0" Grid.Column="2" Classes="key" ToolTip.Tip="Keyframe position at the playhead"
                    Command="{Binding AddKeyframeCommand}" CommandParameter="position"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Center Y"/>
            <TextBox Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding CenterY, Converter={x:Static core:DoubleTextConverter.Instance}}"/>
            <Button Grid.Row="1" Grid.Column="2" Classes="key" ToolTip.Tip="Keyframe position at the playhead"
                    Command="{Binding AddKeyframeCommand}" CommandParameter="position"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="Width"/>
            <TextBox Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding ScaleWidth, Converter={x:Static core:DoubleTextConverter.Instance}}"/>
            <Button Grid.Row="2" Grid.Column="2" Classes="key" ToolTip.Tip="Keyframe scale at the playhead"
                    Command="{Binding AddKeyframeCommand}" CommandParameter="scale"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Classes="field" Text="Height"/>
            <TextBox Grid.Row="3" Grid.Column="1" Classes="value" Text="{Binding ScaleHeight, Converter={x:Static core:DoubleTextConverter.Instance}}"/>
            <Button Grid.Row="3" Grid.Column="2" Classes="key" ToolTip.Tip="Keyframe scale at the playhead"
                    Command="{Binding AddKeyframeCommand}" CommandParameter="scale"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Classes="field" Text="Rotation"/>
            <TextBox Grid.Row="4" Grid.Column="1" Classes="value" Text="{Binding Rotation, Converter={x:Static core:DoubleTextConverter.Instance}}"/>
            <Button Grid.Row="4" Grid.Column="2" Classes="key" ToolTip.Tip="Keyframe rotation at the playhead"
                    Command="{Binding AddKeyframeCommand}" CommandParameter="rotation"/>
          </Grid>
        </Expander>

        <Expander Classes="section" Header="PLAYBACK">
          <Grid ColumnDefinitions="82,*,Auto" RowDefinitions="Auto">
            <TextBlock Grid.Column="0" Classes="field" Text="Speed"/>
            <TextBox Grid.Column="1" Classes="value" Text="{Binding Speed, Converter={x:Static core:DoubleTextConverter.Instance}}"/>
          </Grid>
        </Expander>

        <Expander Classes="section" Header="LEVELS">
          <Grid ColumnDefinitions="82,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Volume"/>
            <TextBox Grid.Row="0" Grid.Column="1" Classes="value" Text="{Binding VolumeDb, Converter={x:Static core:DoubleTextConverter.Instance}}"/>
            <Button Grid.Row="0" Grid.Column="2" Classes="key" ToolTip.Tip="Keyframe volume at the playhead"
                    Command="{Binding AddKeyframeCommand}" CommandParameter="volume"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Opacity"/>
            <TextBox Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding Opacity, Converter={x:Static core:DoubleTextConverter.Instance}}"/>
            <Button Grid.Row="1" Grid.Column="2" Classes="key" ToolTip.Tip="Keyframe opacity at the playhead"
                    Command="{Binding AddKeyframeCommand}" CommandParameter="opacity"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="Fade In"/>
            <TextBox Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding FadeInSeconds, Converter={x:Static core:DoubleTextConverter.Instance}}"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Classes="field" Text="Fade Out"/>
            <TextBox Grid.Row="3" Grid.Column="1" Classes="value" Text="{Binding FadeOutSeconds, Converter={x:Static core:DoubleTextConverter.Instance}}"/>
          </Grid>
        </Expander>

        <!-- The engine's grading stack. Zero = off; committing a default
             removes the effect rather than storing a no-op. -->
        <StackPanel IsVisible="{Binding IsVideoClip}">
          <Expander Classes="section" Header="ADJUST">
            <Grid ColumnDefinitions="82,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="0" RowSpacing="2">
              <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Blacks"
                         ToolTip.Tip="-1 to 1"/>
              <TextBox Grid.Row="0" Grid.Column="1" Classes="value" Text="{Binding Blacks, Converter={x:Static core:DoubleTextConverter.Instance}}"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Whites"/>
              <TextBox Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding Whites, Converter={x:Static core:DoubleTextConverter.Instance}}"/>
              <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="Highlights"/>
              <TextBox Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding Highlights, Converter={x:Static core:DoubleTextConverter.Instance}}"/>
              <TextBlock Grid.Row="3" Grid.Column="0" Classes="field" Text="Shadows"/>
              <TextBox Grid.Row="3" Grid.Column="1" Classes="value" Text="{Binding Shadows, Converter={x:Static core:DoubleTextConverter.Instance}}"/>
              <TextBlock Grid.Row="4" Grid.Column="0" Classes="field" Text="Clarity"/>
              <TextBox Grid.Row="4" Grid.Column="1" Classes="value" Text="{Binding Clarity, Converter={x:Static core:DoubleTextConverter.Instance}}"/>
              <TextBlock Grid.Row="5" Grid.Column="0" Classes="field" Text="Dehaze"/>
              <TextBox Grid.Row="5" Grid.Column="1" Classes="value" Text="{Binding Dehaze, Converter={x:Static core:DoubleTextConverter.Instance}}"/>
            </Grid>
          </Expander>

          <Expander Classes="section" Header="EFFECTS">
            <Grid ColumnDefinitions="82,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="2">
              <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Vignette"/>
              <TextBox Grid.Row="0" Grid.Column="1" Classes="value" Text="{Binding VignetteAmount, Converter={x:Static core:DoubleTextConverter.Instance}}"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Grain"/>
              <TextBox Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding GrainAmount, Converter={x:Static core:DoubleTextConverter.Instance}}"/>
              <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="Glow"/>
              <TextBox Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding GlowIntensity, Converter={x:Static core:DoubleTextConverter.Instance}}"/>
              <TextBlock Grid.Row="3" Grid.Column="0" Classes="field" Text="Radius"/>
              <TextBox Grid.Row="3" Grid.Column="1" Classes="value" Text="{Binding GlowRadius, Converter={x:Static core:DoubleTextConverter.Instance}}"/>
              <TextBlock Grid.Row="4" Grid.Column="0" Classes="field" Text="Threshold"/>
              <TextBox Grid.Row="4" Grid.Column="1" Classes="value" Text="{Binding GlowThreshold, Converter={x:Static core:DoubleTextConverter.Instance}}"/>
              <TextBlock Grid.Row="5" Grid.Column="0" Classes="field" Text="Warmth"/>
              <TextBox Grid.Row="5" Grid.Column="1" Classes="value" Text="{Binding GlowWarmth, Converter={x:Static core:DoubleTextConverter.Instance}}"/>
              <TextBlock Grid.Row="6" Grid.Column="0" Classes="field" Text="Invert"/>
              <CheckBox Grid.Row="6" Grid.Column="1" VerticalAlignment="Center"
                        IsChecked="{Binding InvertEnabled, Mode=TwoWay}"/>
            </Grid>
          </Expander>

          <!-- One wheel per channel group; a drag commits once on release.
               Double-tap a wheel to reset it. -->
          <Expander Classes="section" Header="COLOR WHEELS">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,4,0,0">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="LIFT" FontSize="9" HorizontalAlignment="Center"
                           Foreground="{StaticResource ThemeTextMutedBrush}"/>
                <views:ColorWheel x:Name="LiftWheel" Height="78"
                                  Changed="OnWheelChanged" Committed="OnWheelCommitted"
                                  ToolTip.Tip="Drag to tint the shadows; double-tap to reset"/>
                <TextBlock Text="{Binding LiftReadout}" FontSize="9" FontFamily="Consolas"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource ThemeTextMutedBrush}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="GAIN" FontSize="9" HorizontalAlignment="Center"
                           Foreground="{StaticResource ThemeTextMutedBrush}"/>
                <views:ColorWheel x:Name="GainWheel" Height="78"
                                  Changed="OnWheelChanged" Committed="OnWheelCommitted"
                                  ToolTip.Tip="Drag to tint the highlights; double-tap to reset"/>
                <TextBlock Text="{Binding GainReadout}" FontSize="9" FontFamily="Consolas"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource ThemeTextMutedBrush}"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="2">
                <TextBlock Text="GAMMA" FontSize="9" HorizontalAlignment="Center"
                           Foreground="{StaticResource ThemeTextMutedBrush}"/>
                <views:ColorWheel x:Name="GammaWheel" Height="78"
                                  Changed="OnWheelChanged" Committed="OnWheelCommitted"
                                  ToolTip.Tip="Drag to tint the midtones; double-tap to reset"/>
                <TextBlock Text="{Binding GammaReadout}" FontSize="9" FontFamily="Consolas"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource ThemeTextMutedBrush}"/>
              </StackPanel>
            </Grid>
          </Expander>

          <Expander Classes="section" Header="CHROMA KEY">
            <Grid ColumnDefinitions="82,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="2" ColumnSpacing="4">
              <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Key"/>
              <CheckBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Content="Enable"
                        FontSize="11" IsChecked="{Binding ChromaKeyEnabled, Mode=TwoWay}"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Color"
                         ToolTip.Tip="R G B, 0 to 1"/>
              <TextBox Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding ChromaKeyR, Converter={x:Static core:DoubleTextConverter.Instance}}"/>
              <TextBox Grid.Row="1" Grid.Column="2" Classes="value" Text="{Binding ChromaKeyG, Converter={x:Static core:DoubleTextConverter.Instance}}"/>
              <TextBox Grid.Row="1" Grid.Column="3" Classes="value" Text="{Binding ChromaKeyB, Converter={x:Static core:DoubleTextConverter.Instance}}"/>
              <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="Threshold"/>
              <TextBox Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding ChromaThreshold, Converter={x:Static core:DoubleTextConverter.Instance}}"/>
              <TextBlock Grid.Row="3" Grid.Column="0" Classes="field" Text="Spill"/>
              <TextBox Grid.Row="3" Grid.Column="1" Classes="value" Text="{Binding ChromaSpill, Converter={x:Static core:DoubleTextConverter.Instance}}"/>
            </Grid>
          </Expander>

          <Expander Classes="section" Header="LUT">
            <Grid ColumnDefinitions="82,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2">
              <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="File"/>
              <TextBox Grid.Row="0" Grid.Column="1" Classes="value" Text="{Binding LutPath}"
                       Watermark="No LUT" IsReadOnly="True"/>
              <Button Grid.Row="0" Grid.Column="2" Content="…" Padding="8,2" Margin="4,0,0,0"
                      Click="OnChooseLut" ToolTip.Tip="Choose a .cube LUT"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Intensity"/>
              <TextBox Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding LutIntensity, Converter={x:Static core:DoubleTextConverter.Instance}}"/>
            </Grid>
          </Expander>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
