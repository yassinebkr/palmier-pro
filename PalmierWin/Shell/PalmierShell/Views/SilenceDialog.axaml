<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PalmierShell.Views"
        x:Class="PalmierShell.Views.SilenceDialog"
        Title="Remove Silence" Width="380" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{StaticResource ThemeSurfaceBrush}">
  <StackPanel>
  <Border Height="32" Background="{StaticResource ThemeRaisedBrush}"
          BorderBrush="{StaticResource ThemeBorderBrush}" BorderThickness="0,0,0,1"
          PointerPressed="OnTitleBarPressed">
    <DockPanel>
      <views:CaptionButtons DockPanel.Dock="Right" ShowMinimize="False" ShowMaximize="False"/>
      <TextBlock Text="Remove Silence" FontSize="11" VerticalAlignment="Center" Margin="12,0"
                 Foreground="{StaticResource ThemeTextSecondaryBrush}"/>
    </DockPanel>
  </Border>
  <StackPanel Margin="16" Spacing="10">
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" >
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Threshold (dB)" FontSize="12"
                 VerticalAlignment="Center" Margin="0,0,12,0"/>
      <TextBox x:Name="ThresholdBox" Grid.Row="0" Grid.Column="1" FontSize="12" Text="-40"/>
      <TextBlock Grid.Row="1" Grid.Column="0" Text="Min silence (ms)" FontSize="12"
                 VerticalAlignment="Center" Margin="0,10,12,0"/>
      <TextBox x:Name="MinSilenceBox" Grid.Row="1" Grid.Column="1" FontSize="12" Text="500"
               Margin="0,10,0,0"/>
      <TextBlock Grid.Row="2" Grid.Column="0" Text="Padding (ms)" FontSize="12"
                 VerticalAlignment="Center" Margin="0,10,12,0"/>
      <TextBox x:Name="PaddingBox" Grid.Row="2" Grid.Column="1" FontSize="12" Text="100"
               Margin="0,10,0,0"/>
    </Grid>
    <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource ThemeTextTertiaryBrush}"
               TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel"/>
      <Button x:Name="DetectButton" Content="Detect" Click="OnDetect"/>
      <Button x:Name="ApplyButton" Content="Apply" Click="OnApply" IsEnabled="False"
              Classes="primary"/>
    </StackPanel>
  </StackPanel>
  </StackPanel>
</Window>
