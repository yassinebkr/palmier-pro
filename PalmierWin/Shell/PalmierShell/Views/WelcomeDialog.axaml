<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PalmierShell.Views"
        x:Class="PalmierShell.Views.WelcomeDialog"
        Title="Welcome" Width="400" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{StaticResource ThemeSurfaceBrush}">
  <StackPanel>
    <Border Height="32" Background="{StaticResource ThemeRaisedBrush}"
            BorderBrush="{StaticResource ThemeBorderBrush}" BorderThickness="0,0,0,1"
            PointerPressed="OnTitleBarPressed">
      <DockPanel>
        <views:CaptionButtons DockPanel.Dock="Right" ShowMinimize="False" ShowMaximize="False"/>
        <Panel/>
      </DockPanel>
    </Border>
    <StackPanel Margin="18" Spacing="12">
      <TextBlock Text="Welcome to PalmierWin" FontSize="13"/>
      <TextBlock FontSize="12" TextWrapping="Wrap"
                 Foreground="{StaticResource ThemeTextTertiaryBrush}"
                 Text="What should we call you? The name's first letter and the accent you pick mark your badge, the timecode, and commit buttons."/>
      <TextBox x:Name="NameBox" FontSize="12" Watermark="Your name"
               TextChanged="OnNameChanged" KeyDown="OnNameKeyDown"/>
      <views:AccentSwatchPicker x:Name="AccentPicker"/>
      <StackPanel Spacing="4">
        <TextBlock Text="AI editing" FontSize="12"
                   Foreground="{StaticResource ThemeTextTertiaryBrush}"/>
        <RadioButton x:Name="ModeInline" FontSize="12" IsChecked="True"
                     Content="Built-in agent (your API key)"/>
        <RadioButton x:Name="ModeExternal" FontSize="12"
                     Content="An external MCP client (Claude Desktop…)"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="ContinueButton" Content="Continue" Classes="primary"
                FontSize="12" MinWidth="76" IsEnabled="False" Click="OnContinue"/>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</Window>
