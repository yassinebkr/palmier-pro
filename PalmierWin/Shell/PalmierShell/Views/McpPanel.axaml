<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PalmierShell.ViewModels"
             xmlns:views="clr-namespace:PalmierShell.Views"
             x:Class="PalmierShell.Views.McpPanel"
             x:DataType="vm:McpPanelViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="10" Spacing="8">
      <TextBlock Text="Edit with AI" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,0"
                 Foreground="{StaticResource ThemeTextTertiaryBrush}"/>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                 Fill="{StaticResource ThemeSuccessBrush}" IsVisible="{Binding Listening}"/>
        <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                 Fill="{StaticResource ThemeTextMutedBrush}" IsVisible="{Binding !Listening}"/>
        <TextBlock Text="{Binding StatusLine}" FontSize="12" VerticalAlignment="Center"
                   Foreground="{StaticResource ThemeTextSecondaryBrush}"/>
      </StackPanel>
      <!-- Connected and waiting clients; pending ones carry the approval. -->
      <ItemsControl ItemsSource="{Binding Sessions}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:McpSessionRow">
            <Border Margin="0,2" Padding="8,6" CornerRadius="8"
                    Background="{StaticResource ThemeRaisedBrush}"
                    BorderBrush="{StaticResource ThemeBorderBrush}" BorderThickness="1">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontSize="12"
                           Foreground="{StaticResource ThemeTextSecondaryBrush}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Caption}" FontSize="10"
                           Foreground="{StaticResource ThemeTextMutedBrush}"/>
                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Orientation="Horizontal"
                            Spacing="6" VerticalAlignment="Center" IsVisible="{Binding Pending}">
                  <Button Content="Accept" FontSize="11" Padding="8,3" Command="{Binding AcceptCommand}"
                          ToolTip.Tip="Let this client drive the editor (remembered)"/>
                  <Button Content="Deny" FontSize="11" Padding="8,3" Command="{Binding DenyCommand}"/>
                </StackPanel>
                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" FontSize="11" Padding="8,3"
                        Content="Disconnect" VerticalAlignment="Center"
                        IsVisible="{Binding !Pending}" Command="{Binding DisconnectCommand}"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="No client connected yet." FontSize="11" IsVisible="{Binding !HasSessions}"
                 Foreground="{StaticResource ThemeTextMutedBrush}"/>
      <StackPanel IsVisible="{Binding HasCalls}" Spacing="4">
        <TextBlock Text="RECENT TOOL CALLS" FontSize="10" Foreground="{StaticResource ThemeTextMutedBrush}"/>
        <ItemsControl ItemsSource="{Binding RecentCalls}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:McpCallRow">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,1">
                <Ellipse Grid.Column="0" Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                         Fill="{Binding Ok, Converter={x:Static views:AgentPanel.ToolDotBrush}}"/>
                <TextBlock Grid.Column="1" Text="{Binding Tool}" FontSize="11"
                           Foreground="{StaticResource ThemeTextTertiaryBrush}"/>
                <TextBlock Grid.Column="2" Text="{Binding Age}" FontSize="10"
                           Foreground="{StaticResource ThemeTextMutedBrush}"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <StackPanel Spacing="4" Margin="0,6,0,0">
        <TextBlock Text="CONNECT A CLIENT" FontSize="10" Foreground="{StaticResource ThemeTextMutedBrush}"/>
        <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource ThemeTextTertiaryBrush}">
          <Run Text="Point your MCP client at "/><Run Text="{Binding Endpoint}"/>
          <Run Text=" (loopback only). For Claude Desktop, add the repo's stdio shim to claude_desktop_config.json:"/>
        </TextBlock>
        <Border Padding="8,5" CornerRadius="6" Background="{StaticResource ThemeBaseBrush}"
                BorderBrush="{StaticResource ThemeBorderBrush}" BorderThickness="1">
          <SelectableTextBlock Text="{Binding ConfigSnippet}" FontSize="10" FontFamily="Consolas"
                               TextWrapping="Wrap" Foreground="{StaticResource ThemeTextMutedBrush}"/>
        </Border>
        <Button Content="Copy" FontSize="11" Padding="8,3" HorizontalAlignment="Left"
                Click="OnCopySnippet" ToolTip.Tip="Copy the Claude Desktop config"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
