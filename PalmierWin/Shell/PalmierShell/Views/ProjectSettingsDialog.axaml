<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PalmierShell.Views"
        x:Class="PalmierShell.Views.ProjectSettingsDialog"
        Title="Project Settings" Width="380" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{StaticResource ThemeSurfaceBrush}">
  <StackPanel>
  <Border Height="32" Background="{StaticResource ThemeRaisedBrush}"
          BorderBrush="{StaticResource ThemeBorderBrush}" BorderThickness="0,0,0,1"
          PointerPressed="OnTitleBarPressed">
    <DockPanel>
      <views:CaptionButtons DockPanel.Dock="Right" ShowMinimize="False" ShowMaximize="False"/>
      <TextBlock Text="Project Settings" FontSize="11" VerticalAlignment="Center" Margin="12,0"
                 Foreground="{StaticResource ThemeTextSecondaryBrush}"/>
    </DockPanel>
  </Border>
  <StackPanel Margin="16" Spacing="10">
    <TextBlock Text="Aspect ratio" FontSize="12"
               Foreground="{StaticResource ThemeTextSecondaryBrush}"/>
    <ComboBox x:Name="PresetBox" HorizontalAlignment="Stretch"
              SelectionChanged="OnPresetChanged">
      <ComboBoxItem>16:9 — 1920 × 1080</ComboBoxItem>
      <ComboBoxItem>9:16 — 1080 × 1920</ComboBoxItem>
      <ComboBoxItem>1:1 — 1080 × 1080</ComboBoxItem>
      <ComboBoxItem>4:5 — 1080 × 1350</ComboBoxItem>
      <ComboBoxItem>4:3 — 1440 × 1080</ComboBoxItem>
      <ComboBoxItem>Custom</ComboBoxItem>
    </ComboBox>
    <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto">
      <TextBlock Grid.Column="0" Text="Width" FontSize="12" VerticalAlignment="Center"
                 Margin="0,0,8,0" Foreground="{StaticResource ThemeTextTertiaryBrush}"/>
      <TextBox x:Name="WidthBox" Grid.Column="1" FontSize="12" Margin="0,0,12,0"/>
      <TextBlock Grid.Column="2" Text="Height" FontSize="12" VerticalAlignment="Center"
                 Margin="0,0,8,0" Foreground="{StaticResource ThemeTextTertiaryBrush}"/>
      <TextBox x:Name="HeightBox" Grid.Column="3" FontSize="12"/>
    </Grid>
    <TextBlock Text="Even dimensions only, 16 to 7680. Clips keep their place; the canvas letterboxes around them."
               FontSize="11" TextWrapping="Wrap"
               Foreground="{StaticResource ThemeTextTertiaryBrush}"/>
    <TextBlock x:Name="StatusText" FontSize="11" TextWrapping="Wrap"
               Foreground="{StaticResource ThemeTimecodeBrush}"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel"/>
      <Button x:Name="ApplyButton" Content="Apply" Click="OnApply"
              Background="{StaticResource ThemeTimecodeBrush}" Foreground="#111111"/>
    </StackPanel>
  </StackPanel>
  </StackPanel>
</Window>
