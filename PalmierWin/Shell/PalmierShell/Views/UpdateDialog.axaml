<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PalmierShell.Views"
        x:Class="PalmierShell.Views.UpdateDialog"
        Title="Update" Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{StaticResource ThemeSurfaceBrush}">
  <StackPanel>
  <Border Height="32" Background="{StaticResource ThemeRaisedBrush}"
          BorderBrush="{StaticResource ThemeBorderBrush}" BorderThickness="0,0,0,1"
          PointerPressed="OnTitleBarPressed">
    <DockPanel>
      <views:CaptionButtons DockPanel.Dock="Right" ShowMinimize="False" ShowMaximize="False"/>
      <TextBlock Text="Software Update" FontSize="11" VerticalAlignment="Center" Margin="12,0"
                 Foreground="{StaticResource ThemeTextSecondaryBrush}"/>
    </DockPanel>
  </Border>
  <StackPanel Margin="18" Spacing="12">
    <TextBlock x:Name="TitleText" FontSize="13"/>
    <Border MaxHeight="180" BorderBrush="{StaticResource ThemeBorderBrush}"
            BorderThickness="1" CornerRadius="4" Padding="10,8"
            Background="{StaticResource ThemeRaisedBrush}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <SelectableTextBlock x:Name="NotesText" FontSize="12" TextWrapping="Wrap"
                             Foreground="{StaticResource ThemeTextTertiaryBrush}"/>
      </ScrollViewer>
    </Border>
    <StackPanel x:Name="ProgressPanel" IsVisible="False" Spacing="6">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="StatusText" FontSize="11" VerticalAlignment="Center"
                   Foreground="{StaticResource ThemeTextTertiaryBrush}"/>
        <TextBlock x:Name="PercentText" Grid.Column="1" FontSize="11"
                   Foreground="{StaticResource ThemeTimecodeBrush}"/>
      </Grid>
      <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Height="4"
                   Foreground="{StaticResource ThemeTimecodeBrush}"/>
    </StackPanel>
    <TextBlock x:Name="ErrorText" IsVisible="False" FontSize="12" TextWrapping="Wrap"
               Foreground="{StaticResource ThemeErrorBrush}"/>
    <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"/>
  </StackPanel>
  </StackPanel>
</Window>
