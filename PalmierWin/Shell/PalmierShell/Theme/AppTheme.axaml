<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <Color x:Key="ThemeBaseColor">#FF0A0A0A</Color>
    <Color x:Key="ThemeSurfaceColor">#FF161616</Color>
    <Color x:Key="ThemeRaisedColor">#FF1E1E1E</Color>
    <Color x:Key="ThemeProminentColor">#FF2C2C2C</Color>
    <Color x:Key="ThemeTimecodeColor">#FFF29933</Color>
    <Color x:Key="ThemeErrorColor">#FFE54F4F</Color>
    <Color x:Key="ThemeSuccessColor">#FF4FB85F</Color>
    <!-- Primary action: the chosen accent with text that stays readable on
         it, plus one shade up for hover and one down for pressed. Accent.Apply
         rewrites these brushes in place when the accent changes. -->
    <Color x:Key="ThemePrimaryColor">#FFF29933</Color>
    <Color x:Key="ThemePrimaryHoverColor">#FFF4A54B</Color>
    <Color x:Key="ThemePrimaryPressedColor">#FFD5872D</Color>
    <Color x:Key="ThemePrimaryTextColor">#FF1C1A17</Color>
    <Color x:Key="ThemeTrackVideoColor">#FF1D5878</Color>
    <Color x:Key="ThemeTrackAudioColor">#FF2E7765</Color>
    <Color x:Key="ThemeTrackTextColor">#FF715486</Color>
    <SolidColorBrush x:Key="ThemeBaseBrush" Color="{StaticResource ThemeBaseColor}"/>
    <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="{StaticResource ThemeSurfaceColor}"/>
    <SolidColorBrush x:Key="ThemeRaisedBrush" Color="{StaticResource ThemeRaisedColor}"/>
    <SolidColorBrush x:Key="ThemeProminentBrush" Color="{StaticResource ThemeProminentColor}"/>
    <SolidColorBrush x:Key="ThemeTimecodeBrush" Color="{StaticResource ThemeTimecodeColor}"/>
    <SolidColorBrush x:Key="ThemeErrorBrush" Color="{StaticResource ThemeErrorColor}"/>
    <SolidColorBrush x:Key="ThemeSuccessBrush" Color="{StaticResource ThemeSuccessColor}"/>
    <SolidColorBrush x:Key="ThemePrimaryBrush" Color="{StaticResource ThemePrimaryColor}"/>
    <SolidColorBrush x:Key="ThemePrimaryHoverBrush" Color="{StaticResource ThemePrimaryHoverColor}"/>
    <SolidColorBrush x:Key="ThemePrimaryPressedBrush" Color="{StaticResource ThemePrimaryPressedColor}"/>
    <SolidColorBrush x:Key="ThemePrimaryTextBrush" Color="{StaticResource ThemePrimaryTextColor}"/>
    <SolidColorBrush x:Key="ThemeFocusBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="ThemeBorderBrush" Color="#29FFFFFF"/>
    <SolidColorBrush x:Key="ThemeTextBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="#CCFFFFFF"/>
    <SolidColorBrush x:Key="ThemeTextTertiaryBrush" Color="#9EFFFFFF"/>
    <SolidColorBrush x:Key="ThemeTextMutedBrush" Color="#57FFFFFF"/>
    <SolidColorBrush x:Key="ThemeTrackVideoBrush" Color="{StaticResource ThemeTrackVideoColor}"/>
    <SolidColorBrush x:Key="ThemeTrackAudioBrush" Color="{StaticResource ThemeTrackAudioColor}"/>
    <SolidColorBrush x:Key="ThemeTrackTextBrush" Color="{StaticResource ThemeTrackTextColor}"/>
    <!-- Fluent theme overrides: kill the bright default focus/hover borders. -->
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#33FFFFFF"/>
    <!-- CheckBox: the checked state speaks the capsule language, not the
         system accent. -->
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#F5EFE4"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#FCF8F0"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#DED5C2"/>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#1C1A17"/>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#1C1A17"/>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#1C1A17"/>
    <!-- ComboBox dropdown and focus: raised surface, hairline, no accent. -->
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#29FFFFFF"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#33FFFFFF"/>
    <!-- Sliders: neutral track and thumb, never the system accent. -->
    <SolidColorBrush x:Key="SliderTrackFill" Color="#29FFFFFF"/>
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#29FFFFFF"/>
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#73FFFFFF"/>
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#8CFFFFFF"/>
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFD8D8D8"/>
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFF5EFE4"/>
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFB9B9B9"/>
    <!-- The Fluent slider template hard-codes a 20px thumb between two fixed
         15px rows, so in a slim toolbar band the thumb hangs below centre.
         Slim it at the resource level — template local values beat style
         setters, so a Thumb style cannot reach these. -->
    <x:Double x:Key="SliderHorizontalThumbWidth">12</x:Double>
    <x:Double x:Key="SliderHorizontalThumbHeight">12</x:Double>
    <x:Double x:Key="SliderHorizontalHeight">12</x:Double>
    <GridLength x:Key="SliderPreContentMargin">0</GridLength>
    <GridLength x:Key="SliderPostContentMargin">0</GridLength>
    <!-- Text selection: a white wash, not the system accent. -->
    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#40FFFFFF"/>
  </Styles.Resources>
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource ThemeBaseBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource ThemeTextBrush}"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="Button">
    <Setter Property="Background" Value="{StaticResource ThemeProminentBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource ThemeTextBrush}"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="10,4"/>
  </Style>
  <Style Selector="Button /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12"/>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
      </Transitions>
    </Setter>
  </Style>
  <!-- The rest state is ThemeProminent, so hover has to leave it — pointing
       hover back at the same brush is why buttons read as dead under the
       mouse. One shade brighter up, one darker down. -->
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#FF3A3A3A"/>
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#FF232323"/>
  </Style>
  <!-- Toggles and combos share the button language, hover included. -->
  <Style Selector="ToggleButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#FF3A3A3A"/>
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="#FF3A3A3A"/>
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.45"/>
  </Style>
  <!-- Primary action: the accent capsule with readable text. Reserved for
       the one committing button in a dialog or footer. -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource ThemePrimaryBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource ThemePrimaryTextBrush}"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="14,5"/>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ThemePrimaryHoverBrush}"/>
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ThemePrimaryPressedBrush}"/>
  </Style>
  <!-- Focus reads as a hairline, never the Fluent accent ring. -->
  <Style Selector=":is(Control)">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderBrush="{StaticResource ThemeFocusBrush}" BorderThickness="1"
                CornerRadius="4" Margin="-3"/>
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <!-- Fields and combos: one raised surface, one hairline, one height. -->
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{StaticResource ThemeRaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Margin" Value="2,0"/>
    <Setter Property="CornerRadius" Value="4"/>
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#0FFFFFFF"/>
    <Setter Property="CornerRadius" Value="4"/>
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="#14FFFFFF"/>
    <Setter Property="CornerRadius" Value="4"/>
  </Style>
  <!-- Dropdown surface: raised, hairline, 4px radius, at least as wide as
       its combo (the template binds the popup's MinWidth to the control). -->
  <Style Selector="ComboBox /template/ Border#PopupBorder">
    <Setter Property="CornerRadius" Value="4"/>
  </Style>
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{StaticResource ThemeRaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="MinWidth" Value="180"/>
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style Selector="MenuItem:pointerover">
    <Setter Property="Background" Value="#0FFFFFFF"/>
  </Style>
  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{StaticResource ThemeRaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
  </Style>
  <!-- Plain sliders (zoom, prefs) stay slim; the scrub style below slims
       the preview bar further. Thumb size comes from the resource overrides
       above — the Fluent template sets its own as local values. -->
  <Style Selector="ProgressBar">
    <Setter Property="Background" Value="{StaticResource ThemeProminentBrush}"/>
  </Style>
  <!-- Icon buttons sit on a surface only a shade darker than the hover fill,
       so they need a lift of their own: a white wash plus a brighter glyph.
       Without it the hover reads as nothing happening. -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="CornerRadius" Value="5"/>
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#1FFFFFFF"/>
  </Style>
  <Style Selector="Button.icon:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#33FFFFFF"/>
  </Style>
  <Style Selector="Button.icon Path">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Stroke" Duration="0:0:0.12"/>
        <BrushTransition Property="Fill" Duration="0:0:0.12"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.icon:pointerover Path">
    <Setter Property="Stroke" Value="{StaticResource ThemeTextBrush}"/>
  </Style>
  <Style Selector="Button.icon:pointerover TextBlock">
    <Setter Property="Foreground" Value="{StaticResource ThemeTextBrush}"/>
  </Style>
  <!-- The panel-collapse control: a real button you can see at rest. -->
  <Style Selector="Button.railToggle">
    <Setter Property="Background" Value="{StaticResource ThemeRaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="5"/>
    <Setter Property="Padding" Value="6,4"/>
  </Style>
  <Style Selector="Button.railToggle:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ThemeProminentBrush}"/>
    <Setter Property="BorderBrush" Value="#66FFFFFF"/>
  </Style>
  <Style Selector="Button.railToggle:pointerover Path">
    <Setter Property="Stroke" Value="{StaticResource ThemeTextBrush}"/>
  </Style>
  <Style Selector="Button.railToggle Path">
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="Stroke" Duration="0:0:0.12"/></Transitions>
    </Setter>
  </Style>
  <!-- Preview scrub bar: a hairline that thickens under the pointer, so it
       reads as chrome at rest and as a control when you reach for it. -->
  <Style Selector="Slider.scrub /template/ Track">
    <Setter Property="Height" Value="4"/>
  </Style>
  <Style Selector="Slider.scrub /template/ Thumb">
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="Transitions">
      <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.12"/></Transitions>
    </Setter>
  </Style>
  <Style Selector="Slider.scrub:pointerover /template/ Thumb">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="Border.hoverable">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Flyout">
    <Setter Property="Placement" Value="Top"/>
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource ThemeTextBrush}"/>
  </Style>
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{StaticResource ThemeRaisedBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource ThemeTextBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
    <Setter Property="CornerRadius" Value="4"/>
  </Style>
  <!-- AutoCompleteBox ships a light-themed inner TextBox and popup list. -->
  <Style Selector="AutoCompleteBox">
    <Setter Property="Background" Value="{StaticResource ThemeRaisedBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource ThemeTextBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
    <Setter Property="CornerRadius" Value="4"/>
  </Style>
  <Style Selector="AutoCompleteBox /template/ TextBox#PART_TextBox">
    <Setter Property="Background" Value="{StaticResource ThemeRaisedBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource ThemeTextBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
    <Setter Property="CornerRadius" Value="4"/>
  </Style>
  <Style Selector="AutoCompleteBox /template/ ListBox">
    <Setter Property="Background" Value="{StaticResource ThemeRaisedBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource ThemeTextBrush}"/>
  </Style>
  <Style Selector="AutoCompleteBox /template/ Popup Border">
    <Setter Property="Background" Value="{StaticResource ThemeRaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
  </Style>
  <!-- Accordion section (composer, inspector): header row + chevron over a
       hairline, no box chrome. The Fluent Expander theme left-aligns and
       min-widths the control, so the template is local. -->
  <Style Selector="Expander.section">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Margin="0,6,0,0">
          <ToggleButton Classes="hdr" IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                        Background="Transparent" BorderThickness="0" Padding="6,2" Margin="-6,0,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" Cursor="Hand">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{TemplateBinding Header}" FontSize="10" VerticalAlignment="Center"
                         Foreground="{StaticResource ThemeTextMutedBrush}"/>
              <Path Grid.Column="1" Classes="chev" Data="M 0,0 L 5,4 L 0,8 Z" Stretch="Uniform"
                    Width="6" Height="8" Margin="6,0,0,0" VerticalAlignment="Center"
                    Fill="{StaticResource ThemeTextMutedBrush}">
                <Path.RenderTransform>
                  <RotateTransform Angle="0"/>
                </Path.RenderTransform>
                <Path.Transitions>
                  <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
                  </Transitions>
                </Path.Transitions>
              </Path>
            </Grid>
          </ToggleButton>
          <Border Height="1" Background="{StaticResource ThemeBorderBrush}" Margin="0,2,0,0"/>
          <ContentPresenter Content="{TemplateBinding Content}"
                            IsVisible="{TemplateBinding IsExpanded}"
                            HorizontalAlignment="Stretch"
                            Margin="0,4,0,2"/>
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Expander.section /template/ ToggleButton:checked Path.chev">
    <Setter Property="RenderTransform" Value="rotate(90deg)"/>
  </Style>
  <Style Selector="Expander.section /template/ ToggleButton:checked">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Expander.section /template/ ToggleButton:pointerover">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <!-- Hover feedback is a barely-there wash, not the button grey. -->
  <Style Selector="ToggleButton.hdr:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#0FFFFFFF"/>
    <Setter Property="CornerRadius" Value="4"/>
  </Style>
  <!-- Expanded must not read as a selected chip. -->
  <Style Selector="ToggleButton.hdr:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
</Styles>
